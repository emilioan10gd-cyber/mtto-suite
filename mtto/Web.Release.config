<?xml version="1.0" encoding="utf-8"?>

<!-- Transformación aplicada al publicar en Release (hosting).
     Ver https://go.microsoft.com/fwlink/?LinkId=301874 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <!-- ===================================================================
       CADENA DE CONEXIÓN DEL HOSTING
       ===================================================================
       En local se usa "integrated security=True" (tu cuenta de Windows).
       Eso NO existe en un hosting compartido: allá el SQL Server pide
       usuario y contraseña.

       Antes de publicar, sustituye los cuatro marcadores con los datos que
       te dé freeasphosting.net en su panel.

       IMPORTANTE: no subas este archivo a git con la contraseña real.
       Si el repo es público, cualquiera tendría acceso a la base de datos.
  -->
  <connectionStrings>
    <add name="Model1"
         connectionString="data source=SERVIDOR_DEL_HOSTING;initial catalog=NOMBRE_BD_DEL_HOSTING;user id=USUARIO;password=CONTRASENA;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!-- En producción no se filtra el detalle de excepciones al navegador. -->
    <customErrors mode="RemoteOnly" xdt:Transform="Replace" />
  </system.web>

</configuration>
